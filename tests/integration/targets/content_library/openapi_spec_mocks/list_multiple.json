{
  "openapi": "3.0.3",
  "info": {
    "title": "vCenter Library Mock",
    "version": "9.1.0.0"
  },
  "servers": [
    {
      "url": "https://{host}/api",
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    }
  ],
  "paths": {
    "/content/library": {
      "get": {
        "operationId": "Content.Library_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": [
                  {
                    "library_id": "library-1001",
                    "name": "my_library"
                  },
                  {
                    "library_id": "library-1002",
                    "name": "another-library"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/content/library/{library_id}": {
      "get": {
        "operationId": "Content.Library_get",
        "parameters": [
          {
            "name": "library_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "name": "my_library"
                }
              }
            }
          },
          "404": {
            "description": "not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}