{
  "openapi": "3.0.3",
  "info": {
    "title": "vCenter Time Mock",
    "version": "9.1.0.0"
  },
  "servers": [
    {
      "url": "https://{host}/api",
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    }
  ],
  "paths": {
    "/appliance/system/time": {
      "get": {
        "operationId": "Appliance.System.Time_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "date": "Thu 07-31-2014",
                  "time": "18:18:32",
                  "timezone": "UTC",
                  "seconds_since_epoch": 1406830712.0
                }
              }
            }
          },
          "404": {
            "description": "not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}