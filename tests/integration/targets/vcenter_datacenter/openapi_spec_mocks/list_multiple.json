{
  "openapi": "3.0.3",
  "info": {
    "title": "vCenter Datacenter Mock",
    "version": "9.1.0.0"
  },
  "servers": [
    {
      "url": "https://{host}/api",
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    }
  ],
  "paths": {
    "/vcenter/datacenter": {
      "get": {
        "operationId": "Vcenter.Datacenter_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": [
                  {
                    "datacenter": "datacenter-1001",
                    "name": "my_datacenter"
                  },
                  {
                    "datacenter": "datacenter-1002",
                    "name": "another-datacenter"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/vcenter/datacenter/{datacenter}": {
      "get": {
        "operationId": "Vcenter.Datacenter_get",
        "parameters": [
          {
            "name": "datacenter",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "name": "my_datacenter"
                }
              }
            }
          },
          "404": {
            "description": "not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}