{
  "openapi": "3.0.3",
  "info": {
    "title": "vCenter Ipv4 Mock",
    "version": "9.1.0.0"
  },
  "servers": [
    {
      "url": "https://{host}/api",
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    }
  ],
  "paths": {
    "/appliance/networking/interfaces/{interface_name}/ipv4": {
      "get": {
        "operationId": "Appliance.Networking.Interfaces.Ipv4_get",
        "parameters": [
          {
            "name": "interface_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "configurable": true,
                  "mode": "STATIC",
                  "address": "10.20.80.200",
                  "prefix": 24,
                  "default_gateway": "10.20.80.1"
                }
              }
            }
          },
          "404": {
            "description": "not found"
          }
        }
      },
      "put": {
        "operationId": "Appliance.Networking.Interfaces.Ipv4_update",
        "parameters": [
          {
            "name": "interface_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "prefix": {
                    "type": "integer"
                  },
                  "default_gateway": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "ok"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
