{
  "openapi": "3.0.3",
  "info": {
    "title": "vCenter Update Mock",
    "version": "9.1.0.0"
  },
  "servers": [
    {
      "url": "https://{host}/api",
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    }
  ],
  "paths": {
    "/appliance/update": {
      "get": {
        "operationId": "Appliance.Update_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "state": "UP_TO_DATE",
                  "version": "9.1.0.10000",
                  "latest_query_time": "2024-07-31T18:18:32.000Z"
                }
              }
            }
          },
          "404": {
            "description": "not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
