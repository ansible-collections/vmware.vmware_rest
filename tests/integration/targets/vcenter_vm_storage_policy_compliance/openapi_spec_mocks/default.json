{
  "openapi": "3.0.3",
  "info": {
    "title": "vCenter Compliance Mock",
    "version": "9.1.0.0"
  },
  "servers": [
    {
      "url": "https://{host}/api",
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    }
  ],
  "paths": {
    "/vcenter/vm/{vm}/storage/policy/compliance": {
      "get": {
        "operationId": "Vcenter.Vm.Storage.Policy.Compliance_get",
        "parameters": [
          {
            "name": "vm",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "overall_compliance": "COMPLIANT",
                  "vm_home": {
                    "status": "COMPLIANT",
                    "check_time": "2026-09-14T10:00:00.000Z",
                    "policy": "policy-42"
                  },
                  "disks": {
                    "2000": {
                      "status": "COMPLIANT",
                      "check_time": "2026-09-14T10:00:00.000Z",
                      "policy": "policy-42"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
