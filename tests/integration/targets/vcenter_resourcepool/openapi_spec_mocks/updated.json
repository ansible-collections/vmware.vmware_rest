{
  "openapi": "3.0.3",
  "info": {
    "title": "vCenter Resource_Pool Mock",
    "version": "9.1.0.0"
  },
  "servers": [
    {
      "url": "https://{host}/api",
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    }
  ],
  "paths": {
    "/vcenter/resource-pool": {
      "get": {
        "operationId": "Vcenter.ResourcePool_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": [
                  {
                    "resource_pool": "resource_pool-1001",
                    "name": "updated_resource_pool"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/vcenter/resource-pool/{resource_pool}": {
      "get": {
        "operationId": "Vcenter.ResourcePool_get",
        "parameters": [
          {
            "name": "resource_pool",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "name": "updated_resource_pool"
                }
              }
            }
          },
          "404": {
            "description": "not found"
          }
        }
      },
      "patch": {
        "operationId": "Vcenter.ResourcePool_update",
        "parameters": [
          {
            "name": "resource_pool",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "ok"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}