{
  "openapi": "3.0.3",
  "info": {
    "title": "vCenter Folder Mock",
    "version": "9.1.0.0"
  },
  "servers": [
    {
      "url": "https://{host}/api",
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    }
  ],
  "paths": {
    "/vcenter/folder": {
      "get": {
        "operationId": "Vcenter.Folder_list",
        "parameters": [
          {
            "name": "names",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array"
                },
                "example": [
                  {
                    "folder": "group-v1005",
                    "name": "my_folder",
                    "type": "VIRTUAL_MACHINE"
                  },
                  {
                    "folder": "group-h23",
                    "name": "host_folder",
                    "type": "HOST"
                  }
                ]
              }
            }
          },
          "404": {
            "description": "not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
