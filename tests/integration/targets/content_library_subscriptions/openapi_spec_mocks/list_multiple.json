{
  "openapi": "3.0.3",
  "info": {
    "title": "vCenter Subscriptions Mock",
    "version": "9.1.0.0"
  },
  "servers": [
    {
      "url": "https://{host}/api",
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    }
  ],
  "paths": {
    "/content/library/{library}/subscriptions": {
      "get": {
        "operationId": "Content.Library.Subscriptions_list",
        "parameters": [
          {
            "name": "library",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": [
                  {
                    "subscription": "subscriptions-1001",
                    "name": "my_subscriptions"
                  },
                  {
                    "subscription": "subscriptions-1002",
                    "name": "another-subscriptions"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/content/library/{library}/subscriptions/{subscription}": {
      "get": {
        "operationId": "Content.Library.Subscriptions_get",
        "parameters": [
          {
            "name": "library",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subscription",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "name": "my_subscriptions"
                }
              }
            }
          },
          "404": {
            "description": "not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}