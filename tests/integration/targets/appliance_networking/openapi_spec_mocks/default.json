{
  "openapi": "3.0.3",
  "info": {
    "title": "vCenter Networking Mock",
    "version": "9.1.0.0"
  },
  "servers": [
    {
      "url": "https://{host}/api",
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    }
  ],
  "paths": {
    "/appliance/networking": {
      "get": {
        "operationId": "Appliance.Networking_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "dns": {
                    "mode": "STATIC",
                    "hostname": "vcenter.example.com",
                    "servers": [
                      "10.20.80.1"
                    ]
                  },
                  "interfaces": {
                    "nic0": {
                      "name": "nic0",
                      "status": "up",
                      "mac": "00:0C:29:94:BB:5A"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "Appliance.Networking_update",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ipv6_enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "ok"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
