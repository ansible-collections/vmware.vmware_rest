{
  "openapi": "3.0.3",
  "info": {
    "title": "vCenter OVF Library Item Mock - Not Found",
    "version": "9.1.0.0"
  },
  "servers": [
    {
      "url": "https://{host}/api",
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    }
  ],
  "paths": {
    "/vcenter/ovf/library-item/{ovf_library_item_id}": {
      "get": {
        "operationId": "Vcenter.Ovf.LibraryItem_get",
        "parameters": [
          {
            "name": "ovf_library_item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "ovf_library_item_id": "lib-item-1001",
                  "name": "my-ovf-package"
                }
              }
            }
          },
          "404": {
            "description": "not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
