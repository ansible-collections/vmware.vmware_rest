{
  "openapi": "3.0.3",
  "info": {
    "title": "vCenter Subscribed_Library Mock",
    "version": "9.1.0.0"
  },
  "servers": [
    {
      "url": "https://{host}/api",
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    }
  ],
  "paths": {
    "/content/subscribed-library": {
      "get": {
        "operationId": "Content.SubscribedLibrary_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": [
                  {
                    "library_id": "3393956a-43ed-4e7f-bd96-eb39bd604445",
                    "name": "my_subscribed_library"
                  },
                  {
                    "library_id": "b4c5d6e7-8f90-4a1b-9c2d-3e4f5a6b7c8d",
                    "name": "remote_templates"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/content/subscribed-library/{library_id}": {
      "get": {
        "operationId": "Content.SubscribedLibrary_get",
        "parameters": [
          {
            "name": "library_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "id": "3393956a-43ed-4e7f-bd96-eb39bd604445",
                  "name": "my_subscribed_library",
                  "description": "Mirror of the published library",
                  "type": "SUBSCRIBED",
                  "version": "2"
                }
              }
            }
          },
          "404": {
            "description": "not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
